# Application role (atlas_app) used for tenant-scoped requests.
DATABASE_URL_APP="postgresql://atlas_app:REDACTED@localhost:5432/atlas"

# Ops role used for API-key resolution and scheduled aggregation.
DATABASE_URL_OPS="postgresql://atlas_ops:REDACTED@localhost:5432/atlas"

# Schema owner / migration role. Never expose this URL to the browser.
DATABASE_URL_MIGRATION="postgresql://postgres:REDACTED@localhost:5432/atlas"

# Random 32+ byte secret for POST /api/cron/rollups.
CRON_SECRET="replace-with-a-long-random-secret"

# Local benchmark only.
ATLAS_API_KEY="atlas_live_replace-with-a-real-key"
ATLAS_INGEST_URL="http://localhost:3000/api/v1/events"
