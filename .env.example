# ==============================================================================
# ATLAS Multi-Tenant Product Analytics Platform - Environment Configuration
# ==============================================================================

# PostgreSQL Connections (Strict least-privilege roles)
# - App Role (NOBYPASSRLS): Used by the customer application for tenant queries
DATABASE_URL_APP="postgresql://atlas_app:CHANGE_ME_APP_PASSWORD@localhost:5432/atlas_analytics"

# - Ops Role (NOBYPASSRLS): Used exclusively by internal operators & governance
DATABASE_URL_OPS="postgresql://atlas_ops:CHANGE_ME_OPS_PASSWORD@localhost:5432/atlas_analytics"

# - Migration Role: Used exclusively during 'prisma migrate deploy'
DATABASE_URL_MIGRATION="postgresql://postgres:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/atlas_analytics"

# - Fallback ORM Direct Connection (Optional)
DATABASE_URL="postgresql://postgres:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/atlas_analytics"

# Authentication & NextAuth v5 Configuration
# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_WITH_A_RANDOM_32_BYTE_SECRET"
NEXTAUTH_SECRET="CHANGE_ME_WITH_A_RANDOM_32_BYTE_SECRET"
NEXTAUTH_URL="http://localhost:3000"
BASE_URL="http://localhost:3000"

# Background Job & Cron Authentication
CRON_SECRET="CHANGE_ME_WITH_A_RANDOM_CRON_BEARER_SECRET"

# Optional Email Provider (Resend API)
RESEND_API_KEY=""
EMAIL_FROM="Atlas Analytics <no-reply@atlasanalytics.io>"

# Error Tracking & Telemetry (Optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Ingestion Benchmark & Client Tracker (Optional)
ATLAS_API_KEY=""
ATLAS_INGEST_URL="http://localhost:3000/api/v1/events"
ATLAS_ROLLUP_URL="http://localhost:3000/api/cron/rollups"

# Application Logging
LOG_LEVEL="info"
