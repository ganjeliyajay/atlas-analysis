{
  "name": "analysis-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:phase2": "node --env-file-if-exists=.env scripts/seed-phase2.mjs",
    "benchmark:dau": "node --env-file-if-exists=.env scripts/benchmark-dau.mjs",
    "benchmark:ingest": "node --env-file-if-exists=.env scripts/benchmark-ingest.mjs",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:tier1": "node scripts/db-tier1-provision-roles.mjs",
    "db:tier3": "node scripts/db-tier3-normalize-ownership.mjs",
    "test:ingest": "node --env-file-if-exists=.env scripts/test-ingestion.mjs",
    "test:rollups": "node --env-file-if-exists=.env scripts/test-rollup-idempotency.mjs",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "package:release": "node scripts/package-release.mjs",
    "verify:release": "node scripts/verify-release-package.mjs",
    "check:release-scripts": "node --check scripts/package-release.mjs && node --check scripts/verify-release-package.mjs && node --check scripts/db-tier1-provision-roles.mjs && node --check scripts/db-tier3-normalize-ownership.mjs && node --check scripts/deploy/verify-staging-target.mjs && node --check scripts/benchmark-full-ingestion.mjs && node --check scripts/benchmark-5m-ingestion-scale.mjs && node --check scripts/audit-lighthouse.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.12.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.63.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "archiver": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
