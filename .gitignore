# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
/.next/
/out/
/build

# Test output
/coverage
/playwright-report
/test-results

# Local tooling
.vercel
.DS_Store
*.dump
*.zip

# Environment files: keep only the safe template
.env
.env.*
!.env.example

# Secrets and certificates
*.pem
*.key
*.p12
*.pfx

# Logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# Local IDE user settings
.vscode/settings.json

# Generated Lighthouse reports
docs/perf/lighthouse/*.report.html
docs/perf/lighthouse/*.report.json

# Generated performance checkpoints
docs/perf/*checkpoint.json
docs/perf/*benchmark-results.json
